# PayPal Sandbox OAuth 2.0 Credentials
# If omitted, the Web UI runs in a clearly labeled RECORDED_SANDBOX_SIMULATION mode for judge testing.
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_INVOICER_EMAIL=sb-seller@personal.example.com

# Safety guardrail: keep false. Live PayPal API is blocked unless set to true.
PAYPAL_ALLOW_LIVE=false

# Optional OpenAI-Compatible LLM Extractor (OpenAI, OpenRouter, Groq, or Ollama)
# If omitted, the app uses DeterministicExtractor so judges can run offline without a paid key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Web UI HTTP Server Port
PORT=3000
